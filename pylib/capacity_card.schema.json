{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-env capacity card (schema 1)",
  "type": "object",
  "required": [
    "schema", "alias", "written_at", "fingerprint", "config", "benchmark", "depth", "ladder",
    "interference", "ram", "quants", "usable"
  ],
  "properties": {
    "schema": {"const": 1},
    "alias": {"type": "string"},
    "written_at": {"type": "string"},
    "fingerprint": {"type": "string"},
    "config": {
      "type": "object",
      "required": [
        "file", "quantization", "ctx_size", "client_max_output_tokens", "n_gpu_layers", "n_cpu_moe",
        "cache_type_k", "cache_type_v", "ubatch_size", "flash_attn"
      ],
      "properties": {
        "file": {"type": "string"},
        "quantization": {"type": ["string", "null"]},
        "ctx_size": {"type": "integer"},
        "client_max_output_tokens": {"type": ["integer", "null"]},
        "n_gpu_layers": {"type": ["integer", "null"]},
        "n_cpu_moe": {"type": ["integer", "null"]},
        "cache_type_k": {"type": ["string", "null"]},
        "cache_type_v": {"type": ["string", "null"]},
        "ubatch_size": {"type": ["integer", "null"]},
        "flash_attn": {"type": ["boolean", "null"]}
      }
    },
    "benchmark": {
      "type": ["object", "null"],
      "required": ["pp_tps", "tg_tps", "measured_at"],
      "properties": {
        "pp_tps": {"type": ["number", "string", "null"]},
        "tg_tps": {"type": ["number", "string", "null"]},
        "measured_at": {"type": ["string", "null"]}
      }
    },
    "depth": {
      "type": ["object", "null"],
      "required": [
        "fingerprint", "written_at", "source", "points", "model_vram_mib", "peak_temp_c", "avg_sclk_mhz", "limits"
      ],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "source": {"type": "string"},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["depth", "pp_tps", "tg_tps"],
            "properties": {
              "depth": {"type": "integer"},
              "pp_tps": {"type": ["number", "null"]},
              "tg_tps": {"type": ["number", "null"]}
            }
          }
        },
        "model_vram_mib": {"type": ["integer", "null"]},
        "peak_temp_c": {"type": ["integer", "number", "null"]},
        "avg_sclk_mhz": {"type": ["integer", "number", "null"]},
        "limits": {"type": ["object", "null"]}
      }
    },
    "ladder": {
      "type": ["object", "null"],
      "required": [
        "fingerprint", "written_at", "source", "highest_layer", "lowest_effort", "pass_rate", "overall_score",
        "tool_calls", "tool_errors", "tool_error_rate", "invalid_runs"
      ],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "source": {"type": "string"},
        "highest_layer": {"type": ["integer", "null"]},
        "lowest_effort": {"type": ["object", "null"], "additionalProperties": {"type": ["string", "null"]}},
        "pass_rate": {"type": ["number", "null"]},
        "overall_score": {"type": ["number", "null"]},
        "tool_calls": {"type": ["integer", "null"]},
        "tool_errors": {"type": ["integer", "null"]},
        "tool_error_rate": {"type": ["number", "null"]},
        "invalid_runs": {"type": ["integer", "null"]}
      }
    },
    "interference": {
      "type": ["object", "null"],
      "required": [
        "fingerprint", "written_at", "source", "passed", "failures", "notes", "system_one", "omniroute",
        "events_changed", "vram"
      ],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "source": {"type": "string"},
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "system_one": {"type": ["object", "null"]},
        "omniroute": {"type": ["object", "null"]},
        "events_changed": {"type": "array"},
        "vram": {"type": ["object", "null"]}
      }
    },
    "ram": {
      "type": ["object", "null"],
      "required": [
        "fingerprint", "written_at", "llm_server_peak_mib", "llm_server_cap_mib", "host_available_min_mib",
        "swap_delta_mib"
      ],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "llm_server_peak_mib": {"type": ["integer", "null"]},
        "llm_server_cap_mib": {"type": ["integer", "null"]},
        "host_available_min_mib": {"type": ["integer", "null"]},
        "swap_delta_mib": {"type": ["integer", "null"]}
      }
    },
    "quants": {
      "type": ["object", "null"],
      "required": [
        "fingerprint", "written_at", "ctx", "ref_depth", "vram_available_mib", "current", "current_free_mib",
        "candidates", "verdict"
      ],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "ctx": {"type": "integer"},
        "ref_depth": {"type": "integer"},
        "vram_available_mib": {"type": ["integer", "null"]},
        "current": {
          "type": "object",
          "required": ["quant", "file", "weights_mib", "bpw", "sha256"],
          "properties": {
            "quant": {"type": "string"},
            "file": {"type": "string"},
            "weights_mib": {"type": "integer"},
            "bpw": {"type": ["number", "null"]},
            "sha256": {"type": "string"}
          }
        },
        "current_free_mib": {"type": ["integer", "null"]},
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "quant", "file", "size_bytes", "sha256", "weights_mib", "bpw", "delta_mib", "predicted_vram_mib",
              "vram_free_mib", "ram_ok", "fits", "reason", "measured"
            ],
            "properties": {
              "quant": {"type": "string"},
              "file": {"type": ["string", "null"]},
              "size_bytes": {"type": ["integer", "null"]},
              "sha256": {"type": ["string", "null"]},
              "weights_mib": {"type": ["integer", "null"]},
              "bpw": {"type": ["number", "null"]},
              "delta_mib": {"type": ["integer", "null"]},
              "predicted_vram_mib": {"type": ["integer", "null"]},
              "vram_free_mib": {"type": ["integer", "null"]},
              "ram_ok": {"type": ["boolean", "null"]},
              "fits": {"type": ["boolean", "null"]},
              "reason": {"type": ["string", "null"]},
              "budget_required_mib": {"type": ["integer", "null"]},
              "budget_available_mib": {"type": ["integer", "null"]},
              "measured": {
                "type": ["object", "null"],
                "required": [
                  "alias", "quant", "bpw", "ctx", "ref_depth", "points", "model_vram_mib", "interference_passed",
                  "highest_layer", "overall_score", "pass_rate", "delta"
                ],
                "properties": {
                  "delta": {
                    "type": "object",
                    "required": ["pp_at_ref", "tg_at_ref", "model_vram_mib", "highest_layer", "overall_score"]
                  }
                }
              }
            }
          }
        },
        "verdict": {"type": ["string", "null"]}
      }
    },
    "profile": {
      "type": ["object", "null"],
      "required": ["fingerprint", "written_at", "source", "measured_at", "runs", "idle", "skipped"],
      "properties": {
        "fingerprint": {"type": "string"},
        "written_at": {"type": "string"},
        "source": {"type": "string"},
        "measured_at": {"type": ["string", "null"]},
        "n_ctx": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "slack_tokens": {"type": ["integer", "null"]},
        "host_mem_total_mib": {"type": ["integer", "null"]},
        "idle": {"type": ["object", "null"]},
        "skipped": {"type": ["array", "null"]},
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label", "kind", "prompt_n", "input_tps", "ttft_s", "predicted_n", "output_tps", "wall_s", "error", "gpu", "host"
            ],
            "properties": {
              "label": {"type": "string"},
              "kind": {"enum": ["size", "cap", "warmup"]},
              "prompt_n": {"type": ["integer", "null"]},
              "input_tps": {"type": ["number", "null"]},
              "ttft_s": {"type": ["number", "null"]},
              "predicted_n": {"type": ["integer", "null"]},
              "output_tps": {"type": ["number", "null"]},
              "wall_s": {"type": ["number", "null"]},
              "error": {"type": ["string", "null"]},
              "gpu": {"type": ["object", "null"]},
              "host": {"type": ["object", "null"]}
            }
          }
        }
      }
    },
    "usable": {
      "type": "object",
      "required": ["context_tokens", "max_output_tokens", "basis"],
      "properties": {
        "context_tokens": {"type": ["integer", "null"]},
        "max_output_tokens": {"type": ["integer", "null"]},
        "basis": {"type": "string"}
      }
    },
    "stale_sections": {"type": "array", "items": {"type": "string"}}
  }
}
